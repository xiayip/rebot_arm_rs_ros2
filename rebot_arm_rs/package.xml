<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rebot_arm_rs</name>
  <version>0.1.0</version>
  <description>Aggregate package for the six-axis reBot Arm B601-RS ROS 2 stack.</description>
  <maintainer email="yipeng.xia@hotmail.com">reBot ARM RS Developers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Product-owned packages from this repository. -->
  <exec_depend>rebot_arm_rs_bringup</exec_depend>
  <exec_depend>rebot_arm_rs_description</exec_depend>
  <exec_depend>rebot_robstride_protocol</exec_depend>

  <!-- Generic MIT controller subset from the zephyr_controllers repository.
       Depend on individual packages instead of its broad meta-package. -->
  <exec_depend>gravity_compensation_model</exec_depend>
  <exec_depend>mit_controller</exec_depend>
  <exec_depend>mit_damping_controller</exec_depend>
  <exec_depend>mit_impedance_controller</exec_depend>
  <exec_depend>mit_position_adapter_controller</exec_depend>

  <!-- Standard action controller for the optional official parallel gripper. -->
  <exec_depend>parallel_gripper_controller</exec_depend>

  <!-- Generic bus ABI/runtime from the shared_can_hardware repository. -->
  <exec_depend>shared_can_interface</exec_depend>
  <exec_depend>shared_can_ros2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
