<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rebot_arm_rs">
  <xacro:arg name="use_mock_hardware" default="false"/>
  <xacro:arg name="mock_sensor_commands" default="false"/>
  <xacro:arg name="can_interface" default="can1"/>
  <xacro:arg name="auto_enable_on_activate" default="true"/>

  <xacro:include filename="$(find rebot_arm_rs_description)/urdf/rebot_arm_rs/rebot_arm_rs_macro.urdf.xacro"/>
  <xacro:include filename="$(find rebot_arm_rs_description)/urdf/rebot_arm_rs/rebot_arm_rs.ros2_control.xacro"/>

  <xacro:rebot_arm_rs/>
  <xacro:rebot_arm_rs_ros2_control
    name="RebotArmRsSystem"
    use_mock_hardware="$(arg use_mock_hardware)"
    mock_sensor_commands="$(arg mock_sensor_commands)"
    can_interface="$(arg can_interface)"
    auto_enable_on_activate="$(arg auto_enable_on_activate)"/>
</robot>
