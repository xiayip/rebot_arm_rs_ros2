<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="rebot_arm_rs_joint_interfaces" params="name motor_id model kp kd lower upper velocity_max torque_max kp_max kd_max">
    <joint name="${name}">
      <param name="protocol_plugin">rebot_robstride_protocol/RobStrideProtocol</param>
      <param name="protocol_instance">arm_robstride</param>
      <param name="motor_id">${motor_id}</param>
      <param name="model">${model}</param>
      <param name="direction">1.0</param>
      <param name="offset">0.0</param>
      <param name="mit_kp">${kp}</param>
      <param name="mit_kd">${kd}</param>
      <param name="min_position">${lower}</param>
      <param name="max_position">${upper}</param>
      <command_interface name="position">
        <param name="min">${lower}</param>
        <param name="max">${upper}</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-${velocity_max}</param>
        <param name="max">${velocity_max}</param>
        <param name="initial_value">0.0</param>
      </command_interface>
      <command_interface name="kp">
        <param name="minimum">0.0</param>
        <param name="maximum">${kp_max}</param>
        <param name="initial_value">${kp}</param>
      </command_interface>
      <command_interface name="kd">
        <param name="minimum">0.0</param>
        <param name="maximum">${kd_max}</param>
        <param name="initial_value">${kd}</param>
      </command_interface>
      <command_interface name="t_ff">
        <param name="minimum">-${torque_max}</param>
        <param name="maximum">${torque_max}</param>
        <param name="initial_value">0.0</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
    </joint>
  </xacro:macro>

  <xacro:macro name="rebot_arm_rs_isaac_joint_interfaces" params="name lower upper">
    <joint name="${name}">
      <command_interface name="position">
        <param name="min">${lower}</param>
        <param name="max">${upper}</param>
        <param name="initial_value">0.0</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
    </joint>
  </xacro:macro>

  <xacro:macro name="rebot_arm_rs_official_gripper_interfaces" params="name">
    <joint name="${name}">
      <param name="protocol_plugin">rebot_robstride_protocol/RebotGripperProtocol</param>
      <param name="protocol_instance">official_gripper_robstride</param>
      <param name="motor_id">0x07</param>
      <param name="model">rs-00</param>
      <param name="direction">1.0</param>
      <param name="offset">0.0</param>
      <param name="mit_kp">50.0</param>
      <param name="mit_kd">4.0</param>
      <param name="open_position">5.0</param>
      <param name="closed_position">0.0</param>
      <param name="default_velocity">0.25</param>
      <param name="min_position">0.0</param>
      <param name="max_position">1.0</param>
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">1.0</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">0.0</param>
        <param name="max">1.0</param>
        <param name="initial_value">0.25</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="temperature"><param name="initial_value">0.0</param></state_interface>
    </joint>
  </xacro:macro>

  <xacro:macro name="rebot_arm_rs_ros2_control" params="name use_mock_hardware mock_sensor_commands can_interface with_official_gripper:=false">
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="mock_sensor_commands">${mock_sensor_commands}</param>
          <param name="calculate_dynamics">false</param>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>shared_can_ros2/CanSystem</plugin>
          <param name="transport_plugin">shared_can_ros2/SocketCanTransport</param>
          <param name="can_interface">${can_interface}</param>
          <param name="host_id">0xFD</param>
          <param name="require_all_devices">true</param>
          <param name="initial_read_timeout_ms">1200</param>
          <param name="poll_divider">1</param>
          <param name="max_command_step">0.02</param>
        </xacro:unless>
      </hardware>

      <xacro:rebot_arm_rs_joint_interfaces name="joint1" motor_id="0x01" model="rs-06" kp="50.0" kd="3.0" lower="-2.8" upper="2.8" velocity_max="50.0" torque_max="36.0" kp_max="5000.0" kd_max="100.0"/>
      <xacro:rebot_arm_rs_joint_interfaces name="joint2" motor_id="0x02" model="rs-06" kp="150.0" kd="10.0" lower="0" upper="3.63" velocity_max="50.0" torque_max="36.0" kp_max="5000.0" kd_max="100.0"/>
      <xacro:rebot_arm_rs_joint_interfaces name="joint3" motor_id="0x03" model="rs-06" kp="150.0" kd="10.0" lower="0" upper="4.23" velocity_max="50.0" torque_max="36.0" kp_max="5000.0" kd_max="100.0"/>
      <xacro:rebot_arm_rs_joint_interfaces name="joint4" motor_id="0x04" model="rs-00" kp="50.0" kd="5.0" lower="-1.88" upper="1.60" velocity_max="33.0" torque_max="14.0" kp_max="500.0" kd_max="5.0"/>
      <xacro:rebot_arm_rs_joint_interfaces name="joint5" motor_id="0x05" model="rs-00" kp="50.0" kd="4.0" lower="-1.57" upper="1.57" velocity_max="33.0" torque_max="14.0" kp_max="500.0" kd_max="5.0"/>
      <xacro:rebot_arm_rs_joint_interfaces name="joint6" motor_id="0x06" model="rs-00" kp="50.0" kd="4.0" lower="-3.14" upper="3.14" velocity_max="33.0" torque_max="14.0" kp_max="500.0" kd_max="5.0"/>
      <xacro:if value="${with_official_gripper}">
        <xacro:rebot_arm_rs_official_gripper_interfaces name="gripper_command_joint"/>
      </xacro:if>
    </ros2_control>
  </xacro:macro>

  <xacro:macro name="rebot_arm_rs_isaac_ros2_control" params="name with_official_gripper:=false">
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
        <param name="joint_commands_topic">/rebot_arm_rs/isaac_joint_commands</param>
        <param name="joint_states_topic">/rebot_arm_rs/isaac_joint_states</param>
        <param name="trigger_joint_command_threshold">-1.0</param>
        <param name="sum_wrapped_joint_states">false</param>
        <param name="publish_full_joint_command_arrays">true</param>
      </hardware>

      <xacro:rebot_arm_rs_isaac_joint_interfaces name="joint1" lower="-2.8" upper="2.8"/>
      <xacro:rebot_arm_rs_isaac_joint_interfaces name="joint2" lower="0" upper="3.63"/>
      <xacro:rebot_arm_rs_isaac_joint_interfaces name="joint3" lower="0" upper="4.23"/>
      <xacro:rebot_arm_rs_isaac_joint_interfaces name="joint4" lower="-1.88" upper="1.60"/>
      <xacro:rebot_arm_rs_isaac_joint_interfaces name="joint5" lower="-1.57" upper="1.57"/>
      <xacro:rebot_arm_rs_isaac_joint_interfaces name="joint6" lower="-3.14" upper="3.14"/>
      <xacro:if value="${with_official_gripper}">
        <xacro:rebot_arm_rs_isaac_joint_interfaces name="gripper_command_joint" lower="0.0" upper="1.0"/>
      </xacro:if>
    </ros2_control>
  </xacro:macro>
</robot>
