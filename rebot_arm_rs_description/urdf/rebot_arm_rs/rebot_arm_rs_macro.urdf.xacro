<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find rebot_arm_rs_description)/urdf/rebot_arm_rs/rebot_arm_rs_visuals.urdf.xacro"/>

  <xacro:macro name="rebot_arm_rs_inertial" params="com mass ixx ixy ixz iyy iyz izz">
    <inertial>
      <origin xyz="${com}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}" iyy="${iyy}" iyz="${iyz}" izz="${izz}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="rebot_arm_rs_collision" params="mesh">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rebot_arm_rs_description/meshes/rebot_arm_rs/${mesh}"/>
      </geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="rebot_arm_rs_link" params="name mesh com mass ixx ixy ixz iyy iyz izz">
    <link name="${name}">
      <xacro:rebot_arm_rs_inertial
        com="${com}" mass="${mass}"
        ixx="${ixx}" ixy="${ixy}" ixz="${ixz}"
        iyy="${iyy}" iyz="${iyz}" izz="${izz}"/>
      <xacro:rebot_arm_rs_collision mesh="${mesh}"/>
    </link>
  </xacro:macro>

  <xacro:macro name="rebot_arm_rs">
    <!--
      Inertial data is synchronized from Seeed-Projects/reBotArm_control_py,
      urdf/00-arm-rs_asm-v3/urdf/00-arm-rs_asm-v3.urdf at commit edf9279.
      Only the six-axis arm is included; the upstream gripper is intentionally omitted.
    -->
    <xacro:rebot_arm_rs_link
      name="base_link" mesh="base_link.STL"
      com="2.87641888266442E-06 -0.000122302488725115 0.0243376121934547"
      mass="1.1774"
      ixx="0.00133040" ixy="0.00000001" ixz="0.00000000"
      iyy="0.00213119" iyz="0.00000000" izz="0.00275877"/>
    <xacro:rebot_arm_rs_link
      name="link1" mesh="link1.STL"
      com="0.00817652280320541 0.00122584211922395 0.0331419658967293"
      mass="0.4655"
      ixx="0.00025207" ixy="0.00000000" ixz="-0.00002832"
      iyy="0.00015464" iyz="0.00000000" izz="0.00023416"/>

    <link name="link2">
      <xacro:rebot_arm_rs_inertial
        com="-0.117864812717456 -0.00342226413942967 -0.0271551938501484"
        mass="1.972"
        ixx="0.00073374" ixy="-0.00000043" ixz="0.00000851"
        iyy="0.01255987" iyz="0.00000128" izz="0.01281387"/>
      <xacro:rebot_arm_rs_collision mesh="link2.STL"/>
    </link>

    <link name="link3">
      <xacro:rebot_arm_rs_inertial
        com="0.103427154487799 -0.0664137912104635 -0.0271068687716704"
        mass="1.062"
        ixx="0.00046807" ixy="-0.00003456" ixz="-0.00004260"
        iyy="0.00632695" iyz="0.00000006" izz="0.00648221"/>
      <xacro:rebot_arm_rs_collision mesh="link3.STL"/>
    </link>

    <link name="link4">
      <xacro:rebot_arm_rs_inertial
        com="0.0475544540775559 -0.0441113470158517 -0.0314111924918381"
        mass="0.66"
        ixx="0.00045986" ixy="0.00024219" ixz="-0.0"
        iyy="0.00075258" iyz="-0.0" izz="0.00066742"/>
      <xacro:rebot_arm_rs_collision mesh="link4.STL"/>
    </link>

    <link name="link5">
      <xacro:rebot_arm_rs_inertial
        com="0.0114400622356175 4.7907739316217E-06 0.0380487481818926"
        mass="0.150120457182895"
        ixx="7.34238025911107E-05" ixy="1.35700947009798E-08" ixz="-8.58146433770359E-07"
        iyy="5.5153884237714E-05" iyz="-1.32742144977931E-08" izz="5.29920095811017E-05"/>
      <xacro:rebot_arm_rs_collision mesh="link5.STL"/>
    </link>

    <!-- Stable sixth-axis output frame. A flange variant is attached here. -->
    <link name="link6"/>

    <xacro:rebot_arm_rs_visuals/>

    <joint name="joint1" type="revolute">
      <origin xyz="-0.00034283 -0.00098683 0.075" rpy="0 0 0"/>
      <parent link="base_link"/><child link="link1"/><axis xyz="0 0 -1"/>
      <limit lower="-2.8" upper="2.8" effort="36" velocity="50"/>
    </joint>
    <joint name="joint2" type="revolute">
      <origin xyz="0.020343 0.027237 0.07" rpy="-1.5708 0 0"/>
      <parent link="link1"/><child link="link2"/><axis xyz="0 0 1"/>
      <limit lower="0" upper="3.14" effort="36" velocity="50"/>
    </joint>
    <joint name="joint3" type="revolute">
      <origin xyz="-0.236 0 0" rpy="0 0 0"/>
      <parent link="link2"/><child link="link3"/><axis xyz="0 0 -1"/>
      <limit lower="0" upper="3.14" effort="36" velocity="50"/>
    </joint>
    <joint name="joint4" type="revolute">
      <origin xyz="0.228 -0.072746 0.0045" rpy="0 0 0"/>
      <parent link="link3"/><child link="link4"/><axis xyz="0 0 -1"/>
      <limit lower="-1.57" upper="1.57" effort="14" velocity="40"/>
    </joint>
    <joint name="joint5" type="revolute">
      <origin xyz="0.087 -0.048 -0.03075" rpy="-1.5708 0 0"/>
      <parent link="link4"/><child link="link5"/><axis xyz="0 0 -1"/>
      <limit lower="-1.57" upper="1.57" effort="14" velocity="40"/>
    </joint>
    <joint name="joint6" type="revolute">
      <origin xyz="0.0365 0 0.048" rpy="0 1.5708 0"/>
      <parent link="link5"/><child link="link6"/><axis xyz="0 0 -1"/>
      <limit lower="-3.14" upper="3.14" effort="14" velocity="40"/>
    </joint>

  </xacro:macro>
</robot>
